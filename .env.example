# Convex control plane — environment key contract (consumed by Tasks 1-7).
#
# This file lists key NAMES only — no values, ever. Never write a value into
# this file or any other tracked file; never commit a populated `.env`.
#
# Supply the values at runtime by either path:
#   dev  — infisical run -- docker compose -f infra/compose.yml up -d
#   prod — cp .env.example .env   (fill it in) then
#          docker compose --env-file .env -f infra/compose.yml up -d
# Both feed the same plain ${VAR} placeholders in infra/compose.yml; nothing
# here is tied to a specific tool.
#
# Keys marked (required) must be present or services will fail at `up`.

# (required) Public DNS suffix you control. Projects are served at
# <slug>.<BASE_DOMAIN> (site / HTTP actions) and <slug>-api.<BASE_DOMAIN>
# (Convex API); the control plane UI is served at <BASE_DOMAIN> itself.
BASE_DOMAIN=

# (required) Postgres passwords.
CONTROL_PG_PASSWORD=
CONVEX_PG_PASSWORD=

# (required) better-auth signing secret: at least 32 characters.
BETTER_AUTH_SECRET=
# (required) AES-256-GCM key for project-secret encryption: base64 of EXACTLY
# 32 bytes. Task 3 rejects any other length.
SECRETS_KEY=

# OAuth providers (optional; leave unset to disable a provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Let's Encrypt DNS-01 challenge credential for the provider configured in
# infra/traefik/traefik.yml (currently Cloudflare).
# injected from Infisical project convex-control-plane at runtime — never commit a value
CF_DNS_API_TOKEN=

# Image for per-project Convex backend containers (optional; compose falls
# back to `ghcr.io/get-convex/convex-backend:latest` when unset). Pin a
# specific REV in production.
CONVEX_BACKEND_IMAGE=
