# Convex control plane — environment key contract (consumed by Tasks 1-7).
#
# SOURCE OF TRUTH: the Infisical project `convex-control-plane`. This file
# lists key NAMES only — no values, ever. Never write a value into this file
# or any other tracked file; never commit a populated `.env`.
#
# Infisical project: convex-control-plane
#
# Every key below is injected at runtime. Run the stack as:
#   infisical run -- docker compose -f infra/compose.yml up -d
# (Pattern 3) so compose's ${...} placeholders resolve from the Infisical
# project environment. `infisical run -- docker compose -f infra/compose.yml
# config` renders the file the same way.
#
# Keys marked (required) must be present or services will fail at `up`.

# Public DNS suffix you control. Projects are served at
# <slug>.<BASE_DOMAIN> (site / HTTP actions) and <slug>-api.<BASE_DOMAIN>
# (Convex API); the control plane UI is served at <BASE_DOMAIN> itself.
BASE_DOMAIN=

# Postgres passwords.
CONTROL_PG_PASSWORD=
CONVEX_PG_PASSWORD=

# better-auth signing secret: at least 32 characters.
BETTER_AUTH_SECRET=
# AES-256-GCM key for project-secret encryption: base64 of EXACTLY 32 bytes.
# Task 3 rejects any other length.
SECRETS_KEY=

# OAuth providers (optional; leave unset to disable a provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Let's Encrypt DNS-01 challenge credential for the provider configured in
# infra/traefik/traefik.yml (currently Cloudflare).
# injected from Infisical project convex-control-plane at runtime — never commit a value
CF_DNS_API_TOKEN=

# Image for per-project Convex backend containers (optional; compose falls
# back to `ghcr.io/get-convex/convex-backend:latest` when unset). Pin a
# specific REV in production.
CONVEX_BACKEND_IMAGE=
