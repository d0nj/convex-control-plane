# Convex control plane — environment contract (consumed by Tasks 1-7).
#
# Copy this file to `infra/.env` (next to infra/compose.yml) and fill in real
# values. Compose resolves the project directory from the first `-f` file, so
# a `.env` at the repo root is NOT picked up by
#   docker compose -f infra/compose.yml up -d
# (pass `--env-file .env` explicitly if you prefer to keep it at the root).
#
# Only this `.example` file is tracked — never commit a filled-in `.env`.

# Public DNS suffix you control. Projects are served at
# <slug>.<BASE_DOMAIN> (site / HTTP actions) and <slug>-api.<BASE_DOMAIN>
# (Convex API); the control plane UI is served at <BASE_DOMAIN> itself.
BASE_DOMAIN=convex.example.com

# --- Postgres passwords (generate: openssl rand -hex 32) ---
CONTROL_PG_PASSWORD=replace-me-control-pg-password
CONVEX_PG_PASSWORD=replace-me-convex-pg-password

# --- Application secrets ---
# better-auth signing secret: at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
# AES-256-GCM key for project-secret encryption: base64 of EXACTLY 32 bytes
# (openssl rand -base64 32). Task 3 rejects any other length.
SECRETS_KEY=replace-me-with-base64-encoded-32-bytes

# --- OAuth providers (optional; leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Traefik ACME (Let's Encrypt DNS-01 challenge) ---
# Credential for the DNS provider configured in infra/traefik/traefik.yml
# (currently Cloudflare). Needs permission to edit DNS records for
# BASE_DOMAIN. The ACME contact address is admin@BASE_DOMAIN.
CLOUDFLARE_DNS_API_TOKEN=

# --- Convex backend ---
# Image for per-project backend containers. Pin a specific REV in production;
# `latest` matches the upstream default.
CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend:latest
