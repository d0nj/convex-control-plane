# Next.js build output and TypeScript incremental cache. `.next/` is also
# covered by the repo-root .gitignore; repeated here so the web app is
# self-contained if its directory is ever split out.
.next/
out/
# next-env.d.ts is regenerated by `next dev`/`next build` — never commit it.
next-env.d.ts
next-env.d.ts.bak
*.tsbuildinfo
